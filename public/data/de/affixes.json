{
  "ver-": {
    "kind": "prefix",
    "meaning": {
      "en": "changes the meaning; often \"wrongly\", \"away\" or \"completely\"",
      "tr": "anlamı değiştirir; çoğu zaman \"yanlış\", \"uzağa\", \"tamamen\"",
      "de": "verändert die Bedeutung; oft „falsch\", „weg\" oder „ganz\"",
      "fr": "change le sens ; souvent « mal », « loin » ou « complètement »",
      "it": "cambia il significato; spesso \"male\", \"via\" o \"del tutto\"",
      "es": "cambia el significado; a menudo \"mal\", \"lejos\" o \"del todo\""
    }
  },
  "be-": {
    "kind": "prefix",
    "meaning": {
      "en": "makes a verb take a direct object; \"about, on\"",
      "tr": "fiili geçişli yapar; \"üzerine, hakkında\"",
      "de": "macht das Verb transitiv; „über, an\"",
      "fr": "rend le verbe transitif ; « sur, à propos de »",
      "it": "rende il verbo transitivo; \"su, riguardo a\"",
      "es": "hace transitivo el verbo; \"sobre, acerca de\""
    }
  },
  "ent-": {
    "kind": "prefix",
    "meaning": {
      "en": "beginning, coming out; or away, removing",
      "tr": "başlama, ortaya çıkma; ya da uzaklaşma, giderme",
      "de": "Beginn, Entstehen; oder weg, entfernen",
      "fr": "début, apparition ; ou éloignement",
      "it": "inizio, nascita; oppure via, togliere",
      "es": "comienzo, surgimiento; o alejamiento"
    }
  },
  "er-": {
    "kind": "prefix",
    "meaning": {
      "en": "reaching a result; getting to know",
      "tr": "bir sonuca ulaşma; öğrenme",
      "de": "ein Ergebnis erreichen; erkennen",
      "fr": "atteindre un résultat ; apprendre",
      "it": "raggiungere un risultato; venire a sapere",
      "es": "alcanzar un resultado; llegar a saber"
    }
  },
  "ge-": {
